# ─── Anthropic (optional if using MiniMax) ────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ─── MiniMax ─────────────────────────────────────────────────────────────────
# MiniMax Coding Plan API key
MINIMAX_API_KEY=

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Telegram @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# ─── OpenClaw Gateway ─────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=0.0.0.0

# ─── Directories ──────────────────────────────────────────────────────────────
OPENCLAW_CONFIG_DIR=/home/openclaw/.openclaw
OPENCLAW_WORKSPACE_DIR=/home/openclaw/.openclaw/workspace
OPENCLAW_GWS_CONFIG_DIR=/home/openclaw/.config/gws

# ─── Template Runtime ─────────────────────────────────────────────────────────
INSTANCE_ID=
INSTANCE_SLUG=
TEMPLATE_SLUG=executive
CONTROL_PLANE_URL=https://www.clawstaffing.com
RUNTIME_SYNC_TOKEN=
CUSTOMER_TIMEZONE=America/Denver
TEMPLATE_RUNTIME_PORT=3001
AGENTMAIL_API_KEY=
AGENTMAIL_POD_ID=
AGENTMAIL_API_KEY_ID=
AGENTMAIL_INBOX_ID=
AGENTMAIL_EMAIL_ADDRESS=
AGENTMAIL_INBOX_USERNAME=
AGENTMAIL_INBOX_DOMAIN=

# ─── GitHub ───────────────────────────────────────────────────────────────────
# github.com/settings/tokens → Fine-grained or Classic PAT
# Scopes needed: repo, workflow, read:org (for the github skill: PRs, issues, CI)
GH_TOKEN=

# ─── Brave Search ─────────────────────────────────────────────────────────────
# brave.com/search/api (free tier)
BRAVE_SEARCH_API_KEY=

# ─── Customer Hostname (Caddy auto-TLS) ──────────────────────────────────────
# FQDN for this instance — Caddy auto-provisions Let's Encrypt certs.
# DNS must point to this VPS IP before starting.
CUSTOMER_HOSTNAME=your-name.clawstaffing.com

# ─── HTTP Basic Auth (Caddy) ────────────────────────────────────────────────
# First authentication layer — browsers prompt for username/password.
# Generate hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
BASIC_AUTH_USER=customer
BASIC_AUTH_HASH=

# ─── GHCR (GitHub Container Registry) ─────────────────────────────────────────
# Your GitHub username for pulling Docker images
GHCR_USERNAME=

# ─── Workspace Git Sync (optional) ──────────────────────────────────────────
# Daily commit+push of ~/.openclaw/workspace to a private GitHub repo.
# Create a PAT at: github.com/settings/tokens with 'repo' scope
# Auto-enables when GIT_WORKSPACE_REPO is set
GIT_WORKSPACE_REPO=your-username/openclaw-workspace
GIT_WORKSPACE_BRANCH=auto
GIT_WORKSPACE_TOKEN=
# Cron schedule: minute hour day month weekday (default: daily at 4 AM UTC)
GIT_WORKSPACE_SYNC_SCHEDULE=0 4 * * *
